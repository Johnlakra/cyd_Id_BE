{
  "name": "profile-backend",
  "version": "1.0.0",
  "description": "Simple Node.js backend with authentication and profile management",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/migrate.js && node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/initDatabase.js",
    "init-shop-db": "node scripts/initShopDatabase.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.2"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "authentication",
    "backend"
  ],
  "author": "Your Name",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/quiet.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "maxWorkers": 1
  }
}
