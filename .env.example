# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cyd_new

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Cloudinary (profile photos, shop logos/banners, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# --- Shop module: peer-to-peer UPI payments ---
# The platform never holds money: buyers pay each seller's own UPI ID directly and the seller
# confirms receipt. See docs/PAYMENTS.md. All values below are optional; defaults shown.
# PAY_WINDOW_MINUTES=30      # buyer must pay and submit the UTR within this time
# PAY_GRACE_MINUTES=10       # silent extra time before an unpaid order is actually cancelled
# CONFIRM_WINDOW_HOURS=24    # seller must confirm before the buyer may open a dispute
# DISPUTE_PROOF_HOURS=24     # buyer must upload proof after the seller reports "not received"
# MAX_OPEN_UPI_ORDERS=3      # unpaid UPI orders a buyer may have at once

# Comma-separated list of allowed frontend origins (leave empty to allow any origin)
# CORS_ORIGINS=https://johnlakra.github.io
