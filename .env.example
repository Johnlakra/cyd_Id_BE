# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cyd_new

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Cloudinary (profile photos, shop logos/banners, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# --- Shop module: payments ---
# Which gateway adapter to use. "youpi" = YouPI-PG (see services/payments/youpiGateway.js for
# its important limitations), "cod" = cash-on-delivery only, no online payment.
PAYMENT_GATEWAY=youpi

# YouPI-PG connection (see https://github.com/youpi-pg/YouPI-PG). Point these at wherever you
# are running your own YouPI-PG instance - it is self-hosted, there is no shared/public instance.
YOUPI_BASE_URL=http://localhost:7000
YOUPI_MERCHANT_PUBLIC_KEY=
YOUPI_WEBHOOK_SECRET=
